# ─── Miscellaneous ────────────────────────────────────────────────────────────
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
*.orig

# ─── Editors ──────────────────────────────────────────────────────────────────
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code (keep .vscode/ if you share launch configs with your team,
# otherwise un-comment the line below)
# .vscode/

# ─── Flutter / Dart / Pub ─────────────────────────────────────────────────────
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
pubspec.lock       # keep only for apps; remove this line if you want lock committed

# Generated files
lib/generated_plugin_registrant.dart
coverage/

# ─── Secrets & API Keys (NEVER commit these) ──────────────────────────────────
# Environment / secret files
.env
.env.*
!.env.example
secrets.dart
lib/secrets.dart
lib/config/secrets.dart
**/*_secret*
**/*_secrets*
**/*api_key*

# Firebase / Google Services
google-services.json
GoogleService-Info.plist

# ─── iOS ──────────────────────────────────────────────────────────────────────
# (detailed rules live in ios/.gitignore; these catch common top-level leaks)
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/**/.symlinks/
**/ios/**/DerivedData/
**/ios/Flutter/ephemeral/

# ─── Android ──────────────────────────────────────────────────────────────────
# (detailed rules live in android/.gitignore)
# Local SDK/NDK path — machine-specific, never commit
android/local.properties
# Signing keys — NEVER commit
key.properties
**/*.keystore
**/*.jks
# Build outputs
/android/app/debug/
/android/app/profile/
/android/app/release/
**/.gradle/

# ─── macOS ────────────────────────────────────────────────────────────────────
macos/Flutter/GeneratedPluginRegistrant.swift
macos/Flutter/ephemeral/

# ─── Web ──────────────────────────────────────────────────────────────────────
lib/generated_plugin_registrant.dart

# ─── Obfuscation / Symbolication ──────────────────────────────────────────────
app.*.symbols
app.*.map.json

# ─── FVM (Flutter Version Manager) ───────────────────────────────────────────
# Exclude the local SDK symlink and internal FVM state files
.fvm/flutter_sdk
.fvm/versions/
.fvm/release
.fvm/version
# Keep version config so teammates use the same Flutter version
!.fvmrc
!.fvm/fvm_config.json
# ─── iOS / Xcode ──────────────────────────────────────────────────────────────
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.mobileprovision
*.p8
*.p12
*.cer
ios/Pods/
ios/Podfile.lock
